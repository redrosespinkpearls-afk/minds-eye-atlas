{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minds-eye-atlas",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "AtlasStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AtlasStore"
      ]
    }
  ]
}
